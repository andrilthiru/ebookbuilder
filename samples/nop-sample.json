  {
   "id": "s2",
   "title_ta": "வளரும் கலைஞர்கள்",
   "title_en": "Budding Artistes",
   "intro": "",
   "stories": [
    {
     "id": "st2",
     "kind": "script",
     "layout": "image",
     "title_ta": "பகிர்வு",
     "title_en": "Sharing",
     "author": "மாதிரி எழுத்தாளர்",
     "thumb": "",
     "pages": [
      {
       "img": "",
       "audio": "",
       "ta": "(வகுப்பறை. இடைவேளை நேரம்.)\nகவின்: என் உணவுப் பெட்டியை வீட்டில் மறந்துவிட்டேன்.\nநிலா: கவலைப்படாதே. என் இட்லியைப் பகிர்ந்து சாப்பிடலாம்.\nகவின்: நன்றி, நிலா! நாளை நான் உனக்கு வடை கொண்டு வருவேன்.",
       "en": ""
      },
      {
       "img": "",
       "audio": "",
       "ta": "(ஆசிரியர் உள்ளே வருகிறார்.)\nஆசிரியர்: என்ன இங்கே மகிழ்ச்சியான சத்தம்?\nநிலா: நாங்கள் உணவைப் பகிர்ந்துகொள்கிறோம், ஐயா.\nஆசிரியர்: பகிர்வதே உண்மையான நட்பு!",
       "en": ""
      }
     ],
     "glossary": {
      "இடைவேளை": "ஓய்வு நேரம்",
      "பகிர்ந்து": "பங்கிட்டு"
     },
     "activities": [
      {
       "type": "mcq",
       "q_ta": "கவின் எதை வீட்டில் மறந்தான்?",
       "q_en": "",
       "options": [
        "புத்தகம்",
        "உணவுப் பெட்டி",
        "பை"
       ],
       "answer": 1
      }
     ]
    }
   ]
  },
  {
   "id": "s3",
   "title_ta": "வளரும் கவிஞர்கள்",
   "title_en": "Budding Poets",
   "intro": "",
   "stories": [
    {
     "id": "st3",
     "kind": "poem",
     "layout": "image",
     "title_ta": "மழை",
     "title_en": "Rain",
     "author": "மாதிரி கவிஞர்",
     "thumb": "",
     "pages": [
      {
       "img": "",
       "audio": "",
       "ta": "கருமேகம் கூடியது வானில்,\nகுளிர்காற்று வீசியது தோப்பில்;\nசிறுதுளிகள் விழுந்தன மண்ணில்,\nமண்வாசம் நிறைந்தது ஊரில்.\n\nகுடை பிடித்து நடந்தோம் நாங்கள்,\nகப்பல் விட்டு மகிழ்ந்தோம் நாங்கள்;\nமழையே, நீ வருவாய் மீண்டும்,\nமனமெல்லாம் பூக்கும் என்றும்!",
       "en": ""
      }
     ],
     "glossary": {
      "கருமேகம்": "கரிய மேகம்",
      "மண்வாசம்": "மழைக்குப் பின் மண்ணின் மணம்"
     },
     "activities": [
      {
       "type": "blank",
       "q_ta": "விடுபட்ட சொற்களை நிரப்புக.",
       "q_en": "",
       "text": "சிறுதுளிகள் விழுந்தன [மண்ணில்],\n[மண்வாசம்] நிறைந்தது ஊரில்."
      }
     ]
    }
   ]
  }
