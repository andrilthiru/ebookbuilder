   "intro": "",
   "stories": [
    {
     "id": "st1",
     "kind": "story",
     "layout": "image",
     "title_ta": "சில்லறை",
     "title_en": "The Change",
     "author": "மாதிரி எழுத்தாளர்",
     "thumb": "",
     "pages": [
      {
       "img": "",
       "audio": "",
       "ta": "மாலை நேரம். மீனா அருகிலுள்ள கடையில் பொருட்கள் வாங்கினாள்.",
       "en": ""
      },
      {
       "img": "",
       "audio": "",
       "ta": "கடைக்காரர் தவறுதலாக அதிகச் சில்லறையைத் திருப்பிக் கொடுத்தார்.",
       "en": ""
      },
      {
       "img": "",
       "audio": "",
       "ta": "“யாருக்கும் தெரியாது” என்று மனதில் ஒரு குரல் சொன்னது. ஆனால் மீனா தயங்கினாள்.",
       "en": ""
      },
      {
       "img": "",
       "audio": "",
       "ta": "அவள் திரும்பிச் சென்று பணத்தைக் கொடுத்தாள். அவள் மனம் நிம்மதியானது.",
       "en": ""
      }
     ],
     "glossary": {
      "சில்லறை": "மீதிப் பணம்",
      "கடைக்காரர்": "கடை நடத்துபவர்",
      "தவறுதலாக": "தெரியாமல், பிழையாக",
      "தயங்கினாள்": "செய்யலாமா என்று யோசித்து நின்றாள்",
      "நிம்மதி": "மன அமைதி"
     },
     "activities": [
      {
       "type": "mcq",
       "q_ta": "கடைக்காரர் என்ன தவறு செய்தார்?",
       "q_en": "",
       "options": [
        "பொருளை மறந்தார்",
        "அதிகச் சில்லறை கொடுத்தார்",
        "கடையை மூடினார்"
       ],
       "answer": 1
      },
      {
       "type": "match",
       "q_ta": "சொல்லையும் பொருளையும் பொருத்துக.",
       "q_en": "",
       "pairs": [
